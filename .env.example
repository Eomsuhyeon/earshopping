# ---- 필수는 아니지만, 없으면 자동으로 데모 모드로 동작합니다 ----

# Groq API 키 (https://console.groq.com)
GROQ_API_KEY=
# 사용할 모델. 조직 계정에서 특정 모델이 막혀있으면(model_permission_blocked_org 에러)
# https://console.groq.com/settings/limits 에서 활성화하거나, 여기서 다른 모델로 바꾸세요.
# 예: openai/gpt-oss-20b (더 작고 대체로 제한이 적음), qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b
# 1순위 모델이 막혀있거나 폐기됐을 때 자동으로 순서대로 시도할 대체 모델 목록 (콤마 구분)
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.6-27b

# Groq 계정/조직 자체가 막혀있어 위 모델을 전부 못 쓸 때를 대비한 완전히 다른 무료 제공자.
# https://aistudio.google.com/apikey 에서 개인 Google 계정으로 즉시 발급 가능 (조직 승인 불필요).
# 설정해두면 Groq가 전부 실패했을 때 자동으로 이쪽으로 넘어간다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# 세 번째 무료 경로 (Groq와 Gemini 둘 다 막혔을 때). https://openrouter.ai/keys 에서
# 신용카드 없이 무료 발급. "openrouter/free"는 그 시점의 무료 모델을 자동으로 골라주는 라우터.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# eBay Developer 키 (https://developer.ebay.com) — 승인까지 최소 영업일 1일 소요
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# production 또는 sandbox
EBAY_ENV=production

# ---- 서버 설정 ----
PORT=3000
NODE_ENV=development

# 브라우저에서 이 서버를 호출할 수 있는 출처 (콤마로 구분). 비워두면 동일 출처만 허용.
CORS_ORIGINS=

# 분당 IP당 최대 요청 수 (남용 방지)
RATE_LIMIT_PER_MINUTE=60
